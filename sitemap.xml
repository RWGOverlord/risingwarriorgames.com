---
# Front matter makes Jekyll run this through Liquid so blog posts are
# listed automatically. Hand-written pages below are maintained by hand.
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  <!-- latepledge.html is deliberately absent: it is a tracking redirect with
       no content, and carries a noindex meta tag. -->

  <!-- Homepage -->
  <url>
    <loc>https://risingwarriorgames.com/</loc>
    <lastmod>2026-10-01</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>

  <!-- Zombie Overlord -->
  <url>
    <loc>https://risingwarriorgames.com/zombieoverlord.html</loc>
    <lastmod>2026-10-01</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>

  <!-- Rules -->
  <url>
    <loc>https://risingwarriorgames.com/rules.html</loc>
    <lastmod>2026-09-21</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>

  <!-- Rulebook -->
  <url>
    <loc>https://risingwarriorgames.com/rulebook.pdf</loc>
    <lastmod>2026-09-21</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.5</priority>
  </url>

  <!-- Privacy Policy -->
  <url>
    <loc>https://risingwarriorgames.com/privacy.html</loc>
    <lastmod>2026-07-31</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>

  <!-- Blog: the index and every post, generated by Jekyll -->
  <url>
    <loc>https://risingwarriorgames.com/blog/</loc>
    <lastmod>{% if site.posts.size > 0 %}{{ site.posts.first.updated | default: site.posts.first.date | date: '%Y-%m-%d' }}{% else %}{{ site.time | date: '%Y-%m-%d' }}{% endif %}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
{%- for post in site.posts %}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
    <lastmod>{{ post.updated | default: post.date | date: '%Y-%m-%d' }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
{%- endfor %}

</urlset>
